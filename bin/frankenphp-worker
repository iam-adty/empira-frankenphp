#!/usr/bin/env bash
#
# Run an Empira application in a FrankenPHP worker, with this module's loop.
#
#     vendor/bin/frankenphp-worker --app=/path/to/app
#
# The application is bootstrapped exactly as its console would bootstrap it, so
# `bootstrap/app.php` returning the booted Application is the only contract.

set -euo pipefail

app="."
while [ $# -gt 0 ]; do
    case "$1" in
        --app=*) app="${1#*=}" ;;
        --bootstrap=*) bootstrap="${1#*=}" ;;
        --max-requests=*) max_requests="${1#*=}" ;;
        -h|--help)
            sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *) echo "frankenphp-worker: unknown argument $1" >&2; exit 2 ;;
    esac
    shift
done

if [ ! -f "$app/vendor/autoload.php" ]; then
    echo "frankenphp-worker: no vendor/autoload.php in $app — run composer install there first." >&2
    exit 1
fi

# The runtime must be FrankenPHP's own PHP, since `frankenphp_handle_request()`
# is what the loop calls. On anything else this fails immediately and says so,
# which is better than a fatal on an undefined function at the first request.
if ! php -r 'exit(function_exists("frankenphp_handle_request") ? 0 : 1);'; then
    echo "frankenphp-worker: this PHP is not FrankenPHP." >&2
    echo "  Use the frankenphp binary or a frankenphp base image. Under a classic" >&2
    echo "  runtime, run the application directly — it does not need this module." >&2
    exit 1
fi

cd "$app"

export EMPIRA_BOOTSTRAP="${bootstrap:-$(pwd)/bootstrap/app.php}"
export MAX_REQUESTS="${max_requests:-}"

exec frankenphp php-server run \
    -f "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/worker.php" \
    "$@"
